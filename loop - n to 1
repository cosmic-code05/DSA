Using While Loop
#JAVA
import java.util.Scanner;
public class numbers{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the value of n: ");
        int n = sc.nextInt();
        int i = n;
        while(i>=1){
            System.out.println(i);
            i--;
        }
    }
}

